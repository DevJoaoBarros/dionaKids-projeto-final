generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Curso {
  id          Int      @id @default(autoincrement())
  nome        String
  faixaEtaria String
  preco       Float
  turmas      Turma[]
}

model Turma {
  id        Int      @id @default(autoincrement())
  horario   String
  professor String
  cursoId   Int
  curso     Curso    @relation(fields: [cursoId], references: [id])
}