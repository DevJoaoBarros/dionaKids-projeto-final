// Esquema do banco de dados (Prisma).
// Cada "model" vira uma tabela no PostgreSQL.
// Depois de alterar este arquivo, crie uma migração com: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
  // O cliente é gerado do Docker (no build), por isso "native" já é a plataforma certa
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Curso oferecido pela escola (ex.: DionaKidz)
model Curso {
  id          Int      @id @default(autoincrement())
  nome        String
  faixaEtaria String   // texto livre, ex.: "7-11"
  preco       Float
  turmas      Turma[]  // um curso tem várias turmas
}

// Turma de um curso, com horário e professor
model Turma {
  id        Int      @id @default(autoincrement())
  horario   String
  professor String
  cursoId   Int
  curso     Curso    @relation(fields: [cursoId], references: [id])
  matriculas Matricula[]
}

model Aluno {
  id                  Int    @id @default(autoincrement())
  nome                String
  idade               Int
  contatoResponsavel  String
  matriculas          Matricula[]
}

// Liga um aluno a uma turma (relação muitos-para-muitos)
model Matricula {
  id       Int    @id @default(autoincrement())
  alunoId  Int
  turmaId  Int
  aluno    Aluno  @relation(fields: [alunoId], references: [id])
  turma    Turma  @relation(fields: [turmaId], references: [id])

  // O mesmo aluno não pode ser matriculado duas vezes na mesma turma
  @@unique([alunoId, turmaId])
}

// Usuário que faz login no sistema (a senha é guardada como hash bcrypt)
model Usuario {
  id    Int      @id  @default(autoincrement())
  email String   @unique
  senha String
}
